    "src/",
    "examples/",
    "README.md",
    "clavarium-tool.json"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "keywords": [
    "clavarium-assistant",
    "guichet",
    "rag",
    "assistant"
  ]
}
