{
  "name": "guichet",
  "version": "0.2.0",
  "description": "An AI that answers questions from its documents and can do nothing else: no tool, secrets masked, any model provider.",
  "type": "module",
  "bin": {
    "guichet": "bin/guichet.mjs"
  },
  "exports": {
    ".": "./src/core.mjs",
